        // ==========================================
        // Disease-specific trends
        // ==========================================

        function renderDiseaseSpecificTrends(trends) {
            const container = document.getElementById("diseaseSpecificTrends");
            diseaseTrendCharts.forEach(chart => chart.destroy());
            diseaseTrendCharts = [];

            if (!trends || trends.length === 0) {
                container.innerHTML = `<p class="surveillance-empty">No disease-specific monthly trend data is available for this reporting period.</p>`;
                return;
            }

            container.innerHTML = trends.map((disease, index) => {
                const monthlyData = disease.monthlyData || [];
                const totalEncounters = monthlyData.reduce(
                    (total, point) => total + Number(point.encounterCount ?? 0), 0
                );

                const rows = monthlyData.map(point => {
                    const direction = getTrendDirection(point.percentageChange);
                    const hospitals = point.hospitalBreakdown || [];
                    const hospitalDetails = hospitals.length
                        ? hospitals.map(hospital => `<div class="hospital-contribution">${escapeHtml(hospital.institutionName)} (${escapeHtml(hospital.institutionCode)}): ${formatNumber(hospital.encounterCount)} encounters</div>`).join("")
                        : '<span class="text-secondary">No contributing hospitals</span>';

                    return `
                        <tr class="${point.isUnusualIncrease ? "disease-month-alert" : ""}">
                            <td><strong>${escapeHtml(point.month)}</strong>${point.isUnusualIncrease ? '<div class="text-danger small fw-bold">Investigation flag</div>' : ""}</td>
                            <td>${formatNumber(point.encounterCount)}</td>
                            <td><span class="${direction.css} trend-direction">${escapeHtml(formatChange(point.percentageChange))}</span></td>
                            <td><span class="${direction.css} trend-direction">${escapeHtml(direction.text)}</span></td>
                            <td>${formatNumber(hospitals.length)} ${hospitals.length === 1 ? "hospital" : "hospitals"}${hospitalDetails}</td>
                        </tr>`;
                }).join("");

                return `
                    <div class="disease-trend-card">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="disease-trend-heading mb-0">${escapeHtml(disease.diagnosis)}</div>
                            <span class="badge text-bg-light border">${formatNumber(totalEncounters)} encounters</span>
                        </div>
                        <div class="disease-trend-chart">
                            <canvas id="diseaseTrendChart${index}"></canvas>
                        </div>
                        <div class="table-responsive">
                            <table class="surveillance-table">
                                <thead><tr><th>Month</th><th>Encounters</th><th>Monthly Change</th><th>Trend Direction</th><th>Hospital Contributions</th></tr></thead>
                                <tbody>${rows || '<tr><td colspan="5" class="surveillance-empty">No monthly records for this diagnosis.</td></tr>'}</tbody>
                            </table>
                        </div>
                    </div>`;
            }).join("");

            if (typeof Chart !== "undefined") {
                trends.forEach((disease, index) => {
                    const monthlyData = disease.monthlyData || [];
                    const canvas = document.getElementById(`diseaseTrendChart${index}`);
                    if (!canvas || !monthlyData.length) return;
                    const chart = new Chart(canvas, {
                        type: "line",
                        data: {
                            labels: monthlyData.map(point => point.month || ""),
                            datasets: [{
                                label: `${disease.diagnosis} encounters`,
                                data: monthlyData.map(point => Number(point.encounterCount ?? 0)),
                                tension: 0.3,
                                fill: true,
                                borderWidth: 2,
                                pointRadius: 3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: { callbacks: { afterLabel: context => {
                                    const point = monthlyData[context.dataIndex];
                                    return point?.isUnusualIncrease ? "Investigation flag: unusual increase" : "";
                                } } }
                            },
                            scales: {
                                y: { beginAtZero: true, ticks: { precision: 0 }, title: { display: true, text: "Encounters" } },
                                x: { ticks: { maxRotation: 45, minRotation: 0 } }
                            }
                        }
                    });
                    diseaseTrendCharts.push(chart);
                });
            }
        }

                function renderDiseaseSpecificAlerts(trends) {
            const container =
                document.getElementById("diseaseSpecificAlerts");

            const alerts = [];

            (trends || []).forEach(disease => {
                (disease.monthlyData || []).forEach(point => {
                    if (point.isUnusualIncrease) {
                        alerts.push({
                            diagnosis: disease.diagnosis,
                            ...point
                        });
                    }
                });
            });

            if (alerts.length === 0) {
                container.innerHTML = `
                    <div class="surveillance-status">
                        <strong>No disease-specific unusual increases detected.</strong>

                        <p class="mb-0 mt-1 text-secondary">
                            No individual diagnosis met the current statistical
                            alert criteria during this reporting period.
                        </p>
                    </div>
                `;
                return;
            }

            container.innerHTML = `<div class="surveillance-alert-grid">${alerts.map(alert => {
                const hospitals = alert.hospitalBreakdown || [];

                const hospitalList = hospitals.length > 0
                    ? hospitals.map(hospital => `
                        <li>
                            <strong>${escapeHtml(hospital.institutionName)}</strong>
                            (${escapeHtml(hospital.institutionCode)}):
                            ${formatNumber(hospital.encounterCount)} encounters
                        </li>
                    `).join("")
                    : "<li>No hospital contribution details available.</li>";

                return `
                    <div class="surveillance-alert">
                        <div class="surveillance-alert-title">
                            Unusual increase: ${escapeHtml(alert.diagnosis)}
                        </div>

                        <p class="mb-1">
                            Reporting month:
                            <strong>${escapeHtml(alert.month)}</strong>
                        </p>

                        <p class="mb-1">
                            Recorded encounters:
                            <strong>${formatNumber(alert.encounterCount)}</strong>
                        </p>

                        <p class="mb-2">
                            Month-on-month increase:
                            <strong>
                                ${escapeHtml(formatChange(alert.percentageChange))}
                            </strong>
                        </p>

                        <strong class="small">Contributing hospitals:</strong>

                        <ul class="small mt-1 mb-2">
                            ${hospitalList}
                        </ul>

                        <p class="mb-0 small text-secondary">
                            This is a statistical signal requiring further
                            investigation. It does not confirm an outbreak.
                        </p>
                    </div>
                `;
            }).join("")}</div>`;
        }

        // ==========================================
        // Load national surveillance data
        // ==========================================

        let filterOptionsInitialised = false;

        function populateSurveillanceFilterOptions(data) {
            if (filterOptionsInitialised) return;

            const diagnosisSelect = document.getElementById("filterDiagnosis");
            const countySelect = document.getElementById("filterCounty");
            const hospitalSelect = document.getElementById("filterHospital");

            const diagnoses = (data.diagnoses || [])
                .map(x => String(x.diagnosis || "").trim())
                .filter(Boolean)
                .sort((a, b) => a.localeCompare(b));

            const counties = [...new Set((data.counties || [])
                .map(x => String(x.county || "").trim())
                .filter(Boolean))]
                .sort((a, b) => a.localeCompare(b));

            const hospitals = (data.institutions || [])
                .filter(x => x.institutionCode && x.institutionName)
                .sort((a, b) => String(a.institutionName).localeCompare(String(b.institutionName)));
            window.__surveillanceHospitalOptions = hospitals;

            diagnoses.forEach(value => {
                const option = document.createElement("option");
                option.value = value;
                option.textContent = value;
                diagnosisSelect.appendChild(option);
            });

            counties.forEach(value => {
                const option = document.createElement("option");
                option.value = value;
                option.textContent = value;
                countySelect.appendChild(option);
            });

            hospitals.forEach(hospital => {
                const option = document.createElement("option");
                option.value = hospital.institutionCode;
                option.textContent = `${hospital.institutionName} (${hospital.institutionCode})`;
                hospitalSelect.appendChild(option);
            });

            filterOptionsInitialised = true;
        }

        function buildSurveillanceQuery() {
            const params = new URLSearchParams();
            const from = document.getElementById("filterFromUtc").value;
            const to = document.getElementById("filterToUtc").value;
            const diagnosis = document.getElementById("filterDiagnosis").value;
            const county = document.getElementById("filterCounty").value;
            const institutionCode = document.getElementById("filterHospital").value;

            if (from) params.set("fromUtc", `${from}T00:00:00Z`);
            if (to) params.set("toUtc", `${to}T23:59:59.999Z`);
            if (diagnosis) params.set("diagnosis", diagnosis);
            if (county) params.set("county", county);
            if (institutionCode) params.set("institutionCode", institutionCode);

            return params.toString();
        }

        function updateActiveFilterDescription() {
            const labels = [];
            const from = document.getElementById("filterFromUtc").value;
            const to = document.getElementById("filterToUtc").value;
            const diagnosis = document.getElementById("filterDiagnosis").value;
            const county = document.getElementById("filterCounty").value;
            const hospital = document.getElementById("filterHospital");
            if (from) labels.push(`From ${from}`);
            if (to) labels.push(`To ${to}`);
            if (diagnosis) labels.push(`Diagnosis: ${diagnosis}`);
            if (county) labels.push(`County: ${county}`);
            if (hospital.value) labels.push(`Hospital: ${hospital.options[hospital.selectedIndex].text}`);
            document.getElementById("activeSurveillanceFilters").textContent =
                labels.length ? `Active filters — ${labels.join(" | ")}` : "Showing all available surveillance data.";
        }

        async function loadNationalSurveillance() {
            const status =
                document.getElementById("surveillanceStatus");

            status.className = "surveillance-status";
            status.textContent = "Loading national surveillance data...";

            try {
                const surveillanceToken =
                    localStorage.getItem("hospitalRepositoryToken");

                if (!surveillanceToken) {
                    throw new Error(
                        "Please log in before accessing national surveillance."
                    );
                }

                const queryString = buildSurveillanceQuery();
                const requestUrl = queryString
                    ? `/api/surveillance/overview?${queryString}`
                    : "/api/surveillance/overview";

                const response = await fetch(requestUrl, {
                    headers: {
                        "Authorization": `Bearer ${surveillanceToken}`
                    }
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(
                        data.message || `Request failed: ${response.status}`
                    );
                }

                populateSurveillanceFilterOptions(data);
                updateActiveFilterDescription();

                // Summary statistics
                document.getElementById("totalEncounters").textContent =
                    formatNumber(data.totalEncounters);

                document.getElementById("diagnosedEncounters").textContent =
                    formatNumber(data.diagnosedEncounters);

                document.getElementById("reportingHospitals").textContent =
                    formatNumber(data.reportingHospitals);

                document.getElementById("diagnosisCount").textContent =
                    formatNumber(data.diagnoses?.length);

                document.getElementById("reportFrom").textContent =
                    formatDate(data.fromUtc);

                document.getElementById("reportTo").textContent =
                    formatDate(data.toUtc);

                if (data.dataNote) {
                    document.getElementById("surveillanceDataNote").textContent =
                        data.dataNote;
                }

                // Hospital distribution map
                renderHospitalMap(data.institutions || []);

                // County analysis
                renderCountyAnalysis(data.counties || []);

                // Diagnosis doughnut chart
                renderDiagnosisDistributionChart(data.diagnoses || []);

                // Monthly line chart
                renderMonthlyTrendChart(data.monthlyTrend || []);

                // Diagnosis distribution table
                const diagnosisTable =
                    document.getElementById("diagnosisTable");

                if (!data.diagnoses || data.diagnoses.length === 0) {
                    diagnosisTable.innerHTML = `
                        <tr>
                            <td colspan="3" class="surveillance-empty">
                                No recorded diagnoses in this reporting period.
                            </td>
                        </tr>
                    `;
                } else {
                    diagnosisTable.innerHTML = data.diagnoses.map(item => `
                        <tr>
                            <td>${escapeHtml(item.diagnosis)}</td>
                            <td>${formatNumber(item.encounterCount)}</td>
                            <td>${formatNumber(item.reportingHospitals)}</td>
                        </tr>
                    `).join("");
                }

                // National disease burden analysis
                const diseaseBurdenTable =
                    document.getElementById("diseaseBurdenTable");

                const diseaseBurden = data.diseaseBurden || [];
                renderDiseaseBurdenChart(diseaseBurden);

                if (diseaseBurden.length === 0) {
                    diseaseBurdenTable.innerHTML = `
                        <tr>
                            <td colspan="6" class="surveillance-empty">
                                No disease burden data is available for this reporting period.
                            </td>
                        </tr>
                    `;
                } else {
                    diseaseBurdenTable.innerHTML = diseaseBurden.map((item, index) => {
                        const share = Math.max(
                            0,
                            Math.min(
                                100,
                                Number(item.percentageOfDiagnosedEncounters ?? 0)
                            )
                        );

                        return `
                            <tr>
                                <td class="surveillance-rank">#${index + 1}</td>

                                <td>
                                    <strong>${escapeHtml(item.diagnosis)}</strong>
                                </td>

                                <td>${formatNumber(item.encounterCount)}</td>

                                <td class="surveillance-percentage">
                                    ${share.toFixed(2)}%
                                </td>

                                <td>${formatNumber(item.reportingHospitals)}</td>

                                <td>
                                    <div class="surveillance-burden-bar">
                                        <div class="surveillance-burden-fill"
                                             style="width: ${share}%">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        `;
                    }).join("");
                }

                // Hospital reporting statistics and ranked chart
                const institutionTable =
                    document.getElementById("institutionTable");
                renderHospitalReportingChart(data.institutions || []);

                if (!data.institutions || data.institutions.length === 0) {
                    institutionTable.innerHTML = `
                        <tr>
                            <td colspan="4" class="surveillance-empty">
                                No registered hospitals are available.
                            </td>
                        </tr>
                    `;
                } else {
                    institutionTable.innerHTML = data.institutions.map(item => `
                        <tr>
                            <td>${escapeHtml(item.institutionName)}</td>
                            <td>${escapeHtml(item.institutionCode)}</td>
                            <td>${formatNumber(item.encounterCount)}</td>
                            <td>${formatNumber(item.diagnosedEncounters)}</td>
                        </tr>
                    `).join("");
                }

                // Diagnosis comparison across reporting hospitals
                const comparisonHead =
                    document.getElementById("hospitalComparisonHead");

                const comparisonBody =
                    document.getElementById("hospitalComparisonBody");

                const comparisonRecords =
                    data.hospitalDiagnosisComparison || [];

                // Render the new hospital comparison graph
                renderHospitalDiagnosisComparisonChart(comparisonRecords);

                if (comparisonRecords.length === 0) {
                    comparisonHead.innerHTML = `
                        <tr><th>Diagnosis</th></tr>
                    `;

                    comparisonBody.innerHTML = `
                        <tr>
                            <td class="surveillance-empty">
                                No diagnosis comparison data is available
                                for this reporting period.
                            </td>
                        </tr>
                    `;
                } else {
                    const hospitalMap = new Map();

                    comparisonRecords.forEach(item => {
                        const hospitalKey = item.institutionCode;

                        if (!hospitalMap.has(hospitalKey)) {
                            hospitalMap.set(hospitalKey, {
                                institutionCode: item.institutionCode,
                                institutionName: item.institutionName
                            });
                        }
                    });

                    const hospitals = Array.from(hospitalMap.values())
                        .sort((a, b) =>
                            a.institutionName.localeCompare(b.institutionName)
                        );

                    const diagnosisMap = new Map();

                    comparisonRecords.forEach(item => {
                        const diagnosisKey =
                            String(item.diagnosis ?? "").trim().toLowerCase();

                        if (!diagnosisMap.has(diagnosisKey)) {
                            diagnosisMap.set(diagnosisKey, {
                                diagnosis: item.diagnosis,
                                counts: new Map()
                            });
                        }

                        const diagnosis = diagnosisMap.get(diagnosisKey);

                        diagnosis.counts.set(
                            item.institutionCode,
                            Number(item.encounterCount ?? 0)
                        );
                    });

                    const diagnosisRows = Array.from(diagnosisMap.values())
                        .sort((a, b) =>
                            a.diagnosis.localeCompare(b.diagnosis)
                        );

                    comparisonHead.innerHTML = `
                        <tr>
                            <th>Diagnosis</th>

                            ${hospitals.map(hospital => `
                                <th>
                                    ${escapeHtml(hospital.institutionName)}
                                    <small class="d-block text-secondary">
                                        ${escapeHtml(hospital.institutionCode)}
                                    </small>
                                </th>
                            `).join("")}

                            <th>Total</th>
                        </tr>
                    `;

                    comparisonBody.innerHTML = diagnosisRows.map(row => {
                        let total = 0;

                        const hospitalCells = hospitals.map(hospital => {
                            const count =
                                row.counts.get(hospital.institutionCode) ?? 0;

                            total += count;

                            return `
                                <td class="surveillance-count">
                                    ${formatNumber(count)}
                                </td>
                            `;
                        }).join("");

                        return `
                            <tr>
                                <td>${escapeHtml(row.diagnosis)}</td>
                                ${hospitalCells}
                                <td class="surveillance-count">
                                    ${formatNumber(total)}
                                </td>
                            </tr>
                        `;
                    }).join("");
                }

                // Overall monthly trend details and national alerts
                renderMonthlyDetailChart(data.monthlyTrend || []);
                const monthlyTrend =
                    document.getElementById("monthlyTrend");

                const surveillanceAlerts =
                    document.getElementById("surveillanceAlerts");

                const alerts = [];

                if (!data.monthlyTrend || data.monthlyTrend.length === 0) {
                    monthlyTrend.innerHTML = `
                        <p class="surveillance-empty">
                            No monthly records available.
                        </p>
                    `;
                } else {
                    const maximum = Math.max(
                        ...data.monthlyTrend.map(x =>
                            Number(x.totalEncounters ?? 0)
                        ),
                        1
                    );

                    monthlyTrend.innerHTML = data.monthlyTrend.map(item => {
                        const percentage =
                            (Number(item.totalEncounters ?? 0) / maximum) * 100;

                        let changeText = "No previous month available";
                        let changeClass = "surveillance-no-change";

                        if (
                            item.percentageChange !== null &&
                            item.percentageChange !== undefined
                        ) {
                            const change = Number(item.percentageChange);

                            if (change > 0) {
                                changeText =
                                    `${change}% increase in diagnosed encounters`;
                                changeClass = "surveillance-increase";
                            } else if (change < 0) {
                                changeText =
                                    `${Math.abs(change)}% decrease in diagnosed encounters`;
                                changeClass = "surveillance-decrease";
                            } else {
                                changeText =
                                    "No change in diagnosed encounters";
                            }
                        }

                        if (item.isUnusualIncrease) {
                            alerts.push(item);
                        }

                        return `
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="analysis-kpi">
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                        <strong>${escapeHtml(item.month)}</strong>
                                        ${item.isUnusualIncrease ? '<span class="badge text-bg-danger">Review</span>' : '<span class="badge text-bg-light border">Recorded</span>'}
                                    </div>
                                    <div class="value">${formatNumber(item.totalEncounters)}</div>
                                    <div class="caption mb-2">Total encounters</div>
                                    <div class="surveillance-bar mb-2">
                                        <div class="surveillance-bar-fill" style="width: ${percentage}%"></div>
                                    </div>
                                    <div class="d-flex flex-wrap justify-content-between gap-2 small">
                                        <span class="text-secondary">Diagnosed: ${formatNumber(item.diagnosedEncounters)}</span>
                                        <span class="${changeClass}">${escapeHtml(changeText)}</span>
                                    </div>
                                    ${item.isUnusualIncrease ? '<div class="text-danger small fw-bold mt-2">Unusual increase flagged for investigation</div>' : ""}
                                </div>
                            </div>
                        `;
                    }).join("");
                }

                // National alerts
                if (alerts.length === 0) {
                    surveillanceAlerts.innerHTML = `
                        <div class="surveillance-status">
                            <strong>No unusual increases detected.</strong>
                            <p class="mb-0 mt-1 text-secondary">
                                No monthly increase met the current statistical
                                alert criteria during this reporting period.
                            </p>
                        </div>
                    `;
                } else {
                    surveillanceAlerts.innerHTML = `<div class="surveillance-alert-grid">${alerts.map(item => `
                        <div class="surveillance-alert">
                            <div class="surveillance-alert-title">
                                Unusual increase detected:
                                ${escapeHtml(item.month)}
                            </div>

                            <p class="mb-1">
                                Diagnosed encounters increased by
                                <strong>
                                    ${formatNumber(item.percentageChange)}%
                                </strong>
                                compared with the previous month.
                            </p>

                            <small class="text-secondary">
                                Current month:
                                ${formatNumber(item.diagnosedEncounters)}
                                diagnosed encounters.
                            </small>

                            <p class="mb-0 mt-2 small">
                                This is a statistical signal requiring further
                                investigation. It does not confirm an outbreak.
                            </p>
                        </div>
                    `).join("")}</div>`;
                }

                // Disease-specific trends and alerts
                const diseaseTrends = data.diseaseMonthlyTrends || [];

                renderDiseaseSpecificTrends(diseaseTrends);
                renderDiseaseSpecificAlerts(diseaseTrends);

                status.className = "surveillance-status text-success";
                status.textContent =
                    "National surveillance data loaded successfully.";

            } catch (error) {
                console.error("National surveillance error:", error);

                status.className = "surveillance-status text-danger";
                status.textContent =
                    error.message ||
                    "Unable to load national surveillance data.";
            }
        }

        document.getElementById("applySurveillanceFilters")
            .addEventListener("click", () => {
                const from = document.getElementById("filterFromUtc").value;
                const to = document.getElementById("filterToUtc").value;
                if (from && to && from > to) {
                    const status = document.getElementById("surveillanceStatus");
                    status.className = "surveillance-status text-danger";
                    status.textContent = "The start date must be on or before the end date.";
                    return;
                }
                loadNationalSurveillance();
            });

        document.getElementById("resetSurveillanceFilters")
            .addEventListener("click", () => {
                document.getElementById("filterFromUtc").value = "";
                document.getElementById("filterToUtc").value = "";
                document.getElementById("filterDiagnosis").value = "";
                document.getElementById("filterCounty").value = "";
                document.getElementById("filterHospital").value = "";
                loadNationalSurveillance();
            });

        document.getElementById("filterCounty")
            .addEventListener("change", () => {
                // A selected county narrows the hospital choices to that county.
                const county = document.getElementById("filterCounty").value;
                const hospitalSelect = document.getElementById("filterHospital");
                const previous = hospitalSelect.value;
                Array.from(hospitalSelect.options).forEach((option, index) => {
                    if (index === 0) return;
                    const hospitalData = window.__surveillanceHospitalOptions?.find(x => x.institutionCode === option.value);
                    option.hidden = !!county && hospitalData && String(hospitalData.county || "").toLowerCase() !== county.toLowerCase();
                });
                if (previous && hospitalSelect.selectedOptions[0]?.hidden) hospitalSelect.value = "";
            });

        document.getElementById("refreshSurveillance")
            .addEventListener("click", loadNationalSurveillance);

        loadNationalSurveillance();
    })();
</script>
