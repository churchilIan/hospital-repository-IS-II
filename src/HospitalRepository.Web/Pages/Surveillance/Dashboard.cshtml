        // ==========================================
        // Kenya hospital distribution map
        // ==========================================

        let kenyaMap = null;
        let hospitalMarkers = null;

        function initialiseKenyaMap() {
            if (kenyaMap) {
                return;
            }

            if (typeof L === "undefined") {
                document.getElementById("hospitalMapStatus").textContent =
                    "The map library could not be loaded. Check your internet connection.";
                return;
            }

            kenyaMap = L.map("kenyaHospitalMap").setView(
                [-0.0236, 37.9062],
                6
            );

            L.tileLayer(
                "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                {
                    attribution:
                        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                    maxZoom: 18
                }
            ).addTo(kenyaMap);

            hospitalMarkers = L.layerGroup().addTo(kenyaMap);
        }

        function renderHospitalMap(institutions) {
            const status =
                document.getElementById("hospitalMapStatus");

            const registeredCount =
                document.getElementById("registeredHospitalCount");

            const mappedCount =
                document.getElementById("mappedHospitalCount");

            const missingCount =
                document.getElementById("hospitalsWithoutCoordinates");

            if (typeof L === "undefined") {
                status.textContent =
                    "Map library unavailable. Please check your internet connection.";
                return;
            }

            initialiseKenyaMap();

            if (!kenyaMap || !hospitalMarkers) {
                return;
            }

            hospitalMarkers.clearLayers();

            const allHospitals = institutions || [];

            let mapped = 0;
            let missing = 0;

            allHospitals.forEach(hospital => {
                const latitude = Number(hospital.latitude);
                const longitude = Number(hospital.longitude);

                const hasCoordinates =
                    hospital.latitude !== null &&
                    hospital.latitude !== undefined &&
                    hospital.longitude !== null &&
                    hospital.longitude !== undefined &&
                    Number.isFinite(latitude) &&
                    Number.isFinite(longitude) &&
                    latitude >= -5 &&
                    latitude <= 5.5 &&
                    longitude >= 33.5 &&
                    longitude <= 42.5;

                if (!hasCoordinates) {
                    missing++;
                    return;
                }

                mapped++;

                const popupContent = `
                    <div class="hospital-map-popup">
                        <strong>${escapeHtml(hospital.institutionName)}</strong>
                        <hr class="my-2">

                        <div>
                            <strong>Institution code:</strong>
                            ${escapeHtml(hospital.institutionCode)}
                        </div>

                        <div>
                            <strong>County:</strong>
                            ${escapeHtml(hospital.county || "Not recorded")}
                        </div>

                        <div>
                            <strong>Sub-county:</strong>
                            ${escapeHtml(hospital.subCounty || "Not recorded")}
                        </div>

                        <hr class="my-2">

                        <div>
                            <strong>Total encounters:</strong>
                            ${formatNumber(hospital.encounterCount)}
                        </div>

                        <div>
                            <strong>Diagnosed encounters:</strong>
                            ${formatNumber(hospital.diagnosedEncounters)}
                        </div>

                        <div class="small text-secondary mt-2">
                            Recorded clinical encounters during the selected reporting period.
                        </div>
                    </div>
                `;

                const marker = L.marker([latitude, longitude]);

                marker.bindPopup(popupContent);
                marker.addTo(hospitalMarkers);
            });

            registeredCount.textContent =
                formatNumber(allHospitals.length);

            mappedCount.textContent =
                formatNumber(mapped);

            missingCount.textContent =
                formatNumber(missing);

            if (mapped === 0) {
                status.textContent =
                    "No hospitals have valid geographical coordinates yet.";
            } else {
                status.textContent =
                    `${mapped} hospital(s) displayed on the map. ` +
                    `${missing} hospital(s) need geographical coordinates.`;
            }

            window.setTimeout(() => {
                kenyaMap.invalidateSize();
            }, 100);
        }

