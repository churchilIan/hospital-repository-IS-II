        // ==========================================
        // Diagnosis distribution doughnut chart
        // ==========================================

        function renderDiagnosisDistributionChart(diagnoses) {
            const canvas =
                document.getElementById("diagnosisDistributionChart");

            const chartStatus =
                document.getElementById("diagnosisChartStatus");

            if (diagnosisDistributionChart) {
                diagnosisDistributionChart.destroy();
                diagnosisDistributionChart = null;
            }

            const diagnosisRecords = diagnoses || [];

            if (typeof Chart === "undefined") {
                chartStatus.textContent =
                    "Chart.js could not be loaded. Check your internet connection.";
                return;
            }

            if (diagnosisRecords.length === 0) {
                chartStatus.textContent =
                    "There are no recorded diagnoses for this reporting period.";
                return;
            }

            const labels = diagnosisRecords.map(item =>
                String(item.diagnosis ?? "Unspecified diagnosis")
            );

            const values = diagnosisRecords.map(item =>
                Number(item.encounterCount ?? 0)
            );

            const totalEncounters = values.reduce(
                (total, value) => total + value,
                0
            );

            if (totalEncounters === 0) {
                chartStatus.textContent =
                    "There are no diagnosed encounters to display.";
                return;
            }

            diagnosisDistributionChart = new Chart(canvas, {
                type: "doughnut",

                data: {
                    labels: labels,

                    datasets: [{
                        label: "Diagnosed Encounters",
                        data: values,
                        borderWidth: 2,
                        hoverOffset: 8
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "60%",

                    plugins: {
                        legend: {
                            display: true,
                            position: "right",

                            labels: {
                                padding: 12,
                                usePointStyle: true,
                                boxWidth: 10
                            }
                        },

                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    const value = Number(context.raw ?? 0);

                                    const percentage =
                                        (value / totalEncounters) * 100;

                                    return `${context.label}: ${formatNumber(value)} encounters (${percentage.toFixed(2)}%)`;
                                }
                            }
                        }
                    }
                }
            });

            chartStatus.textContent =
                `${formatNumber(totalEncounters)} diagnosed encounters across ${formatNumber(diagnosisRecords.length)} recorded diagnoses.`;
        }

