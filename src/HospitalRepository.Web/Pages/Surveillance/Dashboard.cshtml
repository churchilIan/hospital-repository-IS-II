        // ==========================================
        // NEW: Hospital diagnosis comparison graph
        // ==========================================

        function renderHospitalDiagnosisComparisonChart(records) {
            const canvas =
                document.getElementById("hospitalDiagnosisComparisonChart");

            const chartStatus =
                document.getElementById("hospitalComparisonChartStatus");

            if (hospitalDiagnosisComparisonChart) {
                hospitalDiagnosisComparisonChart.destroy();
                hospitalDiagnosisComparisonChart = null;
            }

            const comparisonRecords = records || [];

            if (typeof Chart === "undefined") {
                chartStatus.textContent =
                    "Chart.js could not be loaded. Check your internet connection.";
                return;
            }

            if (comparisonRecords.length === 0) {
                chartStatus.textContent =
                    "No hospital diagnosis comparison data is available.";
                return;
            }

            const hospitalMap = new Map();

            comparisonRecords.forEach(item => {
                const key = String(item.institutionCode ?? item.institutionName ?? "");

                if (!hospitalMap.has(key)) {
                    hospitalMap.set(key, {
                        institutionCode: item.institutionCode,
                        institutionName: item.institutionName
                    });
                }
            });

            const hospitals = Array.from(hospitalMap.values())
                .sort((a, b) =>
                    String(a.institutionName ?? "").localeCompare(
                        String(b.institutionName ?? "")
                    )
                );

            const diagnosisMap = new Map();

            comparisonRecords.forEach(item => {
                const diagnosisKey =
                    String(item.diagnosis ?? "").trim().toLowerCase();

                if (!diagnosisMap.has(diagnosisKey)) {
                    diagnosisMap.set(diagnosisKey, {
                        diagnosis: item.diagnosis,
                        counts: new Map()
                    });
                }

                const diagnosis = diagnosisMap.get(diagnosisKey);

                const hospitalKey =
                    String(item.institutionCode ?? item.institutionName ?? "");

                diagnosis.counts.set(
                    hospitalKey,
                    Number(item.encounterCount ?? 0)
                );
            });

            const diagnoses = Array.from(diagnosisMap.values())
                .sort((a, b) =>
                    String(a.diagnosis ?? "").localeCompare(
                        String(b.diagnosis ?? "")
                    )
                );

            const datasets = hospitals.map(hospital => {
                const hospitalKey =
                    String(hospital.institutionCode ?? hospital.institutionName ?? "");

                return {
                    label: hospital.institutionName,
                    data: diagnoses.map(diagnosis =>
                        diagnosis.counts.get(hospitalKey) ?? 0
                    ),
                    borderWidth: 1
                };
            });

            hospitalDiagnosisComparisonChart = new Chart(canvas, {
                type: "bar",

                data: {
                    labels: diagnoses.map(item => item.diagnosis),
                    datasets: datasets
                },

                options: {
                    indexAxis: "y",
                    responsive: true,
                    maintainAspectRatio: false,

                    interaction: {
                        intersect: false,
                        mode: "index"
                    },

                    plugins: {
                        legend: {
                            position: "bottom"
                        },

                        tooltip: {
                            callbacks: {
                                label: context =>
                                    `${context.dataset.label}: ${formatNumber(context.raw)} encounters`
                            }
                        }
                    },

                    scales: {
                        x: {
                            beginAtZero: true,

                            title: {
                                display: true,
                                text: "Recorded encounters"
                            },

                            ticks: {
                                precision: 0
                            }
                        },

                        y: {
                            title: {
                                display: true,
                                text: "Diagnosis"
                            }
                        }
                    }
                }
            });

            chartStatus.textContent =
                `Comparing ${diagnoses.length} diagnosis(es) across ${hospitals.length} hospital(s).`;
        }

