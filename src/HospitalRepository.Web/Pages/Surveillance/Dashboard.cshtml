
@page
@{
    ViewData["Title"] = "National Surveillance Dashboard";
}

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
    .surveillance-dashboard { color: var(--bs-body-color); }

    .surveillance-card {
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 12px;
        padding: 20px;
        height: 100%;
    }

    .surveillance-label {
        color: var(--bs-secondary-color);
        font-size: 13px;
        margin-bottom: 8px;
    }

    .surveillance-number {
        font-size: 30px;
        font-weight: 700;
    }

    .surveillance-section {
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 12px;
        padding: 20px;
        margin-top: 22px;
    }

    .surveillance-section h5 {
        font-weight: 650;
        margin-bottom: 18px;
    }

    .surveillance-bar {
        height: 12px;
        background: #e9ecef;
        border-radius: 8px;
        overflow: hidden;
        flex: 1;
    }

    .surveillance-bar-fill,
    .surveillance-burden-fill {
        height: 100%;
        background: #2878c8;
        border-radius: 8px;
    }

    .surveillance-burden-bar {
        height: 10px;
        background: #e9ecef;
        border-radius: 8px;
        overflow: hidden;
        min-width: 100px;
    }

    .surveillance-status {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 18px;
        background: var(--bs-tertiary-bg);
    }

    .surveillance-table {
        width: 100%;
        border-collapse: collapse;
    }

    .surveillance-table th,
    .surveillance-table td {
        padding: 12px 10px;
        border-bottom: 1px solid var(--bs-border-color);
        text-align: left;
        vertical-align: middle;
    }

    .surveillance-table th {
        color: var(--bs-secondary-color);
        font-size: 13px;
        white-space: nowrap;
    }

    .surveillance-empty {
        color: var(--bs-secondary-color);
        padding: 15px 0;
    }

    .surveillance-alert {
        border-left: 5px solid #dc3545;
        background: rgba(220, 53, 69, 0.08);
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 12px;
    }

    .surveillance-alert-title {
        font-weight: 700;
        margin-bottom: 5px;
    }

    .surveillance-increase {
        color: #dc3545;
        font-weight: 700;
    }

    .surveillance-decrease {
        color: #198754;
        font-weight: 700;
    }

    .surveillance-no-change {
        color: var(--bs-secondary-color);
    }

    .surveillance-comparison-table th,
    .surveillance-comparison-table td {
        text-align: center;
    }

    .surveillance-comparison-table th:first-child,
    .surveillance-comparison-table td:first-child {
        text-align: left;
        min-width: 180px;
    }

    .surveillance-count,
    .surveillance-rank,
    .surveillance-percentage {
        font-weight: 700;
    }

    .surveillance-percentage {
        white-space: nowrap;
    }

    .disease-trend-card {
        border: 1px solid var(--bs-border-color);
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 18px;
    }

    .disease-trend-heading {
        font-weight: 700;
        font-size: 17px;
        margin-bottom: 12px;
    }

    .disease-month-alert {
        background: rgba(220, 53, 69, 0.08);
    }

    .hospital-contribution {
        font-size: 12px;
        color: var(--bs-secondary-color);
        margin-top: 4px;
    }

    .trend-direction {
        font-weight: 650;
        white-space: nowrap;
    }

    #kenyaHospitalMap {
        height: 520px;
        width: 100%;
        border-radius: 10px;
        z-index: 1;
    }

    .hospital-map-popup {
        min-width: 220px;
        line-height: 1.6;
    }

    .county-chart-container {
        position: relative;
        height: 420px;
        width: 100%;
    }

    .county-disease-card {
        border: 1px solid var(--bs-border-color);
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 14px;
    }

    .county-disease-heading {
        font-weight: 700;
        margin-bottom: 10px;
    }

    /* Compact chart layout */
    .surveillance-chart-card {
        border: 1px solid var(--bs-border-color);
        border-radius: 10px;
        padding: 16px;
        height: 100%;
        min-width: 0;
    }

    .surveillance-chart-container {
        position: relative;
        height: 310px;
        width: 100%;
    }

    .diagnosis-chart-status {
        color: var(--bs-secondary-color);
        font-size: 13px;
        text-align: center;
        margin-top: 10px;
    }

    .hospital-comparison-chart-container {
        position: relative;
        height: 400px;
        width: 100%;
    }

    .monthly-trend-detail {
        border-top: 1px solid var(--bs-border-color);
        padding-top: 16px;
        margin-top: 18px;
    }

    .analysis-chart-wrap {
        position: relative;
        width: 100%;
        height: 300px;
        min-width: 0;
    }

    .analysis-chart-wrap.tall {
        height: 360px;
    }

    .analysis-chart-wrap.compact {
        height: 240px;
    }

    .analysis-kpi {
        border: 1px solid var(--bs-border-color);
        border-radius: 10px;
        padding: 12px 14px;
        height: 100%;
        background: var(--bs-tertiary-bg);
    }

    .analysis-kpi .value {
        font-size: 1.35rem;
        font-weight: 750;
        line-height: 1.25;
    }

    .analysis-kpi .caption {
        color: var(--bs-secondary-color);
        font-size: .78rem;
    }

    .disease-trend-chart {
        position: relative;
        height: 230px;
        margin: 10px 0 18px;
    }

    .analysis-legend-note {
        color: var(--bs-secondary-color);
        font-size: .78rem;
    }

    .surveillance-alert-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
        gap: 12px;
    }

    .surveillance-alert {
        margin-bottom: 0;
        min-width: 0;
    }

    .surveillance-table th,
    .surveillance-table td {
        overflow-wrap: anywhere;
    }

    @@media (max-width: 767px) {
        .surveillance-section {
            padding: 14px;
        }

        #kenyaHospitalMap {
            height: 380px;
        }

        .surveillance-chart-container {
            height: 280px;
        }

        .hospital-comparison-chart-container {
            height: 350px;
        }
    }
</style>

<div class="container-fluid surveillance-dashboard py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="text-secondary mb-1">National Hospital Repository</p>
            <h1 class="h3 fw-bold mb-1">National Disease Surveillance</h1>
            <p class="text-secondary mb-0">
                Aggregated clinical encounter analysis across participating hospitals.
            </p>
        </div>

        <button id="refreshSurveillance" class="btn btn-primary" type="button">
            Refresh Analysis
        </button>
    </div>

    <!-- Interactive surveillance filters -->
    <div class="surveillance-section mt-0 mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h5 class="mb-1">Filter Surveillance Analysis</h5>
                <p class="text-secondary small mb-0">Apply a reporting period, disease, county or hospital filter to the dashboard.</p>
            </div>
            <button id="resetSurveillanceFilters" class="btn btn-outline-secondary btn-sm" type="button">Reset filters</button>
        </div>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-sm-6 col-xl-2">
                <label class="form-label" for="filterFromUtc">From date</label>
                <input id="filterFromUtc" class="form-control" type="date" />
            </div>
            <div class="col-12 col-sm-6 col-xl-2">
                <label class="form-label" for="filterToUtc">To date</label>
                <input id="filterToUtc" class="form-control" type="date" />
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <label class="form-label" for="filterDiagnosis">Disease / diagnosis</label>
                <select id="filterDiagnosis" class="form-select">
                    <option value="">All diagnoses</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-xl-2">
                <label class="form-label" for="filterCounty">County</label>
                <select id="filterCounty" class="form-select">
                    <option value="">All counties</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-xl-2">
                <label class="form-label" for="filterHospital">Hospital</label>
                <select id="filterHospital" class="form-select">
                    <option value="">All hospitals</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-xl-1 d-grid">
                <button id="applySurveillanceFilters" class="btn btn-primary" type="button">Apply</button>
            </div>
        </div>
        <div id="activeSurveillanceFilters" class="small text-secondary mt-3">Showing all available surveillance data.</div>
    </div>

    <div id="surveillanceStatus" class="surveillance-status">
        Loading national surveillance data...
    </div>

    <!-- Summary statistics -->
    <div class="row g-3">

        <div class="col-12 col-md-6 col-xl-3">
            <div class="surveillance-card">
                <div class="surveillance-label">Total Encounters</div>
                <div id="totalEncounters" class="surveillance-number">--</div>
                <small class="text-secondary">Recorded clinical encounters</small>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="surveillance-card">
                <div class="surveillance-label">Diagnosed Encounters</div>
                <div id="diagnosedEncounters" class="surveillance-number">--</div>
                <small class="text-secondary">Encounters with a diagnosis</small>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="surveillance-card">
                <div class="surveillance-label">Reporting Hospitals</div>
                <div id="reportingHospitals" class="surveillance-number">--</div>
                <small class="text-secondary">Hospitals contributing encounters</small>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="surveillance-card">
                <div class="surveillance-label">Recorded Diagnoses</div>
                <div id="diagnosisCount" class="surveillance-number">--</div>
                <small class="text-secondary">Distinct diagnosis descriptions</small>
            </div>
        </div>

    </div>

    <!-- Diagnosis and monthly charts -->
    <div class="surveillance-section">
        <div class="row g-4">

            <div class="col-12 col-xl-6">
                <div class="surveillance-chart-card">
                    <h5>Diagnosis Distribution</h5>

                    <p class="text-secondary small">
                        Distribution of recorded diagnoses across participating hospitals.
                    </p>

                    <div class="surveillance-chart-container">
                        <canvas id="diagnosisDistributionChart"></canvas>
                    </div>

                    <div id="diagnosisChartStatus" class="diagnosis-chart-status">
                        Waiting for diagnosis data...
                    </div>

                    <p class="text-secondary small mt-3 mb-0">
                        Percentages represent diagnosed encounters, not the national population.
                    </p>
                </div>
            </div>

            <div class="col-12 col-xl-6">
                <div class="surveillance-chart-card">
                    <h5>Monthly Encounter Trends</h5>

                    <p class="text-secondary small">
                        Compare total clinical encounters with diagnosed encounters over time.
                    </p>

                    <div class="surveillance-chart-container">
                        <canvas id="monthlyTrendChart"></canvas>
                    </div>

                    <div id="monthlyChartStatus" class="diagnosis-chart-status">
                        Waiting for monthly data...
                    </div>

                    <p class="text-secondary small mt-3 mb-0">
                        The graph shows recorded encounters per month, not unique patients.
                    </p>
                </div>
            </div>

        </div>
    </div>

    <!-- Diagnosis records table -->
    <div class="surveillance-section">
        <h5>Diagnosis Records</h5>

        <div class="table-responsive">
            <table class="surveillance-table">
                <thead>
                    <tr>
                        <th>Diagnosis</th>
                        <th>Encounters</th>
                        <th>Reporting Hospitals</th>
                    </tr>
                </thead>
                <tbody id="diagnosisTable">
                    <tr><td colspan="3">Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Kenya hospital geographical map -->
    <div class="surveillance-section">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h5 class="mb-1">National Hospital Distribution Map</h5>
                <p class="text-secondary small mb-0">
                    Geographical distribution of registered hospitals
                    participating in the National Hospital Repository.
                </p>
            </div>

            <div class="text-end">
                <div class="fw-bold" id="mappedHospitalCount">0</div>
                <small class="text-secondary">Hospitals mapped</small>
            </div>
        </div>

        <div id="kenyaHospitalMap"></div>

        <div class="d-flex flex-wrap gap-3 mt-3 small text-secondary">
            <span>
                <strong id="registeredHospitalCount">0</strong>
                registered hospitals
            </span>

            <span>
                <strong id="hospitalsWithoutCoordinates">0</strong>
                without coordinates
            </span>
        </div>

        <p class="text-secondary small mt-3 mb-0">
            Select a hospital marker to view its location and recorded
            encounter statistics. Hospitals without coordinates are not
            displayed on the map. Encounter counts are not population-adjusted
            disease rates.
        </p>

        <div id="hospitalMapStatus" class="small text-secondary mt-2">
            Waiting for hospital location data...
        </div>
    </div>

    <!-- County-level disease surveillance -->
    <div class="surveillance-section">
        <h5>County-Level Disease Surveillance</h5>

        <p class="text-secondary small">
            Compare recorded diagnosed encounters across counties
            using the registered locations of participating hospitals.
        </p>

        <div class="county-chart-container">
            <canvas id="countyComparisonChart"></canvas>
        </div>

        <h6 class="fw-bold mt-4 mb-3">County Statistics</h6>

        <div class="table-responsive">
            <table class="surveillance-table">
                <thead>
                    <tr>
                        <th>County</th>
                        <th>Registered Hospitals</th>
                        <th>Reporting Hospitals</th>
                        <th>Total Encounters</th>
                        <th>Diagnosed Encounters</th>
                    </tr>
                </thead>
                <tbody id="countyStatisticsTable">
                    <tr>
                        <td colspan="5">Loading county statistics...</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <h6 class="fw-bold mt-4 mb-3">County Disease Breakdown</h6>

        <div id="countyDiseaseBreakdown">
            Loading county disease breakdown...
        </div>

        <p class="text-secondary small mt-3 mb-0">
            County figures represent encounters reported by hospitals
            registered in each county. They do not establish the residence
            of patients or population-level disease prevalence.
        </p>
    </div>

    <!-- National disease burden analysis -->
    <div class="surveillance-section">
        <h5>National Disease Burden Analysis</h5>

        <p class="text-secondary small">
            This analysis ranks recorded diagnoses according to their
            proportion of all diagnosed clinical encounters during the
            selected reporting period.
        </p>

        <div class="row g-3 align-items-stretch mb-3">
            <div class="col-12 col-xl-8">
                <div class="surveillance-chart-card">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <h6 class="fw-bold mb-0">Leading Diagnoses by Recorded Encounters</h6>
                        <span class="analysis-legend-note">Ranked highest to lowest</span>
                    </div>
                    <div class="analysis-chart-wrap tall">
                        <canvas id="diseaseBurdenChart"></canvas>
                    </div>
                    <div id="diseaseBurdenChartStatus" class="diagnosis-chart-status">Waiting for disease burden data...</div>
                </div>
            </div>
            <div class="col-12 col-xl-4">
                <div class="row g-2 h-100">
                    <div class="col-6 col-xl-12">
                        <div class="analysis-kpi">
                            <div class="caption">Diagnosed encounters represented</div>
                            <div class="value" id="burdenEncounterTotal">--</div>
                        </div>
                    </div>
                    <div class="col-6 col-xl-12">
                        <div class="analysis-kpi">
                            <div class="caption">Diagnoses in burden analysis</div>
                            <div class="value" id="burdenDiagnosisTotal">--</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <p class="small text-secondary mb-0">The chart ranks diagnosis counts. The table below retains each diagnosis' national share and reporting-hospital coverage.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="surveillance-table">
                <thead>
                    <tr>
                        <th>Rank</th>
                        <th>Diagnosis</th>
                        <th>Diagnosed Encounters</th>
                        <th>National Share</th>
                        <th>Reporting Hospitals</th>
                        <th>Distribution</th>
                    </tr>
                </thead>
                <tbody id="diseaseBurdenTable">
                    <tr><td colspan="6">Loading disease burden analysis...</td></tr>
                </tbody>
            </table>
        </div>

        <div class="alert alert-light border mt-3 mb-0">
            <small class="text-secondary">
                <strong>Interpretation:</strong>
                National share represents the percentage of recorded diagnosed
                encounters attributed to a particular diagnosis. It does not
                represent the percentage of the population affected by that disease.
            </small>
        </div>
    </div>

    <!-- Hospital statistics -->
    <div class="surveillance-section">
        <h5>Hospital Reporting Statistics</h5>
        <p class="text-secondary small">Compare the reporting volume and diagnosed encounters recorded by each registered hospital.</p>

        <div class="surveillance-chart-card mb-3">
            <div class="analysis-chart-wrap tall">
                <canvas id="hospitalReportingChart"></canvas>
            </div>
            <div id="hospitalReportingChartStatus" class="diagnosis-chart-status">Waiting for hospital statistics...</div>
        </div>

        <div class="table-responsive">
            <table class="surveillance-table">
                <thead>
                    <tr>
                        <th>Hospital</th>
                        <th>Institution Code</th>
                        <th>Total Encounters</th>
                        <th>Diagnosed Encounters</th>
                    </tr>
                </thead>
                <tbody id="institutionTable">
                    <tr><td colspan="4">Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Hospital diagnosis comparison graph and table -->
    <div class="surveillance-section">
        <h5>Diagnosis Comparison Across Hospitals</h5>

        <p class="text-secondary small">
            Compare the number of recorded encounters for each diagnosis
            across hospitals contributing diagnosed clinical encounters.
        </p>

        <div class="hospital-comparison-chart-container">
            <canvas id="hospitalDiagnosisComparisonChart"></canvas>
        </div>

        <div id="hospitalComparisonChartStatus" class="diagnosis-chart-status mb-3">
            Waiting for hospital comparison data...
        </div>

        <h6 class="fw-bold mt-4 mb-3">Detailed Hospital Comparison</h6>

        <div class="table-responsive">
            <table class="surveillance-table surveillance-comparison-table">
                <thead id="hospitalComparisonHead">
                    <tr><th>Diagnosis</th><th>Loading...</th></tr>
                </thead>
                <tbody id="hospitalComparisonBody">
                    <tr><td colspan="2">Loading comparison data...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Monthly trend details -->
    <div class="surveillance-section">
        <h5>Monthly Trend Details</h5>

        <p class="text-secondary small">
            These bars represent total clinical encounters. Percentage changes compare
            diagnosed encounters with the previous month.
        </p>

        <div class="row g-3 mb-3">
            <div class="col-12 col-lg-8">
                <div class="surveillance-chart-card">
                    <h6 class="fw-bold">Monthly Encounter Volume</h6>
                    <div class="analysis-chart-wrap">
                        <canvas id="monthlyDetailChart"></canvas>
                    </div>
                    <div id="monthlyDetailChartStatus" class="diagnosis-chart-status">Waiting for monthly details...</div>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="row g-2 h-100">
                    <div class="col-6 col-lg-12">
                        <div class="analysis-kpi">
                            <div class="caption">Months reported</div>
                            <div class="value" id="monthlyPeriodCount">--</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-12">
                        <div class="analysis-kpi">
                            <div class="caption">Months flagged for review</div>
                            <div class="value" id="monthlyFlagCount">--</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <p class="small text-secondary mb-0">Diagnosed encounters are included within total encounters; the grouped bars compare the two measures and should not be added together.</p>
                    </div>
                </div>
            </div>
        </div>
        <div id="monthlyTrend" class="row g-3">
            Loading monthly trends...
        </div>
    </div>

    <!-- Disease-specific monthly trends -->
    <div class="surveillance-section">
        <h5>Disease-Specific Monthly Trends</h5>

        <p class="text-secondary small">
            Examine how individual recorded diagnoses change over time.
            Each diagnosis has its own monthly encounter counts, percentage
            changes and contributing hospitals.
        </p>

        <div id="diseaseSpecificTrends">
            Loading disease-specific trends...
        </div>
    </div>

    <!-- National surveillance alerts -->
    <div class="surveillance-section">
        <h5>National Surveillance Alerts</h5>

        <p class="text-secondary small">
            These alerts identify unusually large increases in overall recorded
            diagnosed encounters and indicate where further investigation may be appropriate.
        </p>

        <div id="surveillanceAlerts">
            Checking for unusual increases...
        </div>
    </div>

    <!-- Disease-specific alerts -->
    <div class="surveillance-section">
        <h5>Disease-Specific Surveillance Alerts</h5>

        <p class="text-secondary small">
            These alerts identify individual diagnoses that meet the statistical
            unusual-increase criteria. The contributing hospitals are displayed
            to help guide further investigation.
        </p>

        <div id="diseaseSpecificAlerts">
            Checking disease-specific alerts...
        </div>
    </div>

    <!-- Reporting period -->
    <div class="surveillance-section">
        <h5>Reporting Period</h5>

        <p class="mb-1">
            <strong>From:</strong>
            <span id="reportFrom">--</span>
        </p>

        <p class="mb-0">
            <strong>To:</strong>
            <span id="reportTo">--</span>
        </p>
    </div>

    <div class="alert alert-info mt-4">
        <strong>Data interpretation:</strong>
        <span id="surveillanceDataNote">
            These statistics represent recorded clinical encounters, not confirmed
            disease incidence or unique patients. Diagnosis entries are currently
            free text. An unusual increase is a statistical investigation indicator,
            not proof of an outbreak. Further clinical and public-health investigation
            is required.
        </span>
    </div>

</div>

<!-- Chart.js and Leaflet libraries -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    (() => {
        const formatNumber = value =>
            Number(value ?? 0).toLocaleString();

        const formatDate = value => {
            if (!value) return "--";
            return new Date(value).toLocaleDateString();
        };

        function escapeHtml(value) {
            return String(value ?? "").replace(/[&<>"']/g, character => ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#039;"
            })[character]);
        }

        function formatChange(value) {
            if (value === null || value === undefined) {
                return "No previous cases available";
            }

            const change = Number(value);

            if (change > 0) {
                return `+${change.toFixed(2)}%`;
            }

            return `${change.toFixed(2)}%`;
        }

        function getTrendDirection(value) {
            if (value === null || value === undefined) {
                return {
                    text: "Baseline unavailable",
                    css: "surveillance-no-change"
                };
            }

            const change = Number(value);

            if (change > 0) {
                return {
                    text: "Increasing",
                    css: "surveillance-increase"
                };
            }

            if (change < 0) {
                return {
                    text: "Decreasing",
                    css: "surveillance-decrease"
                };
            }

            return {
                text: "Stable",
                css: "surveillance-no-change"
            };
        }

